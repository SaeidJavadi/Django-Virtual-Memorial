;
; BIND data file for local loopback interface
;
$TTL    604800
@       IN      SOA     ns1.yadbod.cf. root.yadbod.cf. (
                              1          ; Serial
                         604800          ; Refresh
                          86400          ; Retry
                        2419200          ; Expire
                         604800 )        ; Negative Cache TTL

@       IN      A       51.83.29.198

@       IN      NS      ns1.yadbod.cf.
ns1     IN      A       51.83.29.198

@       IN      NS      ns2.yadbod.cf.
ns2     IN      A       51.83.29.198

@       IN      MX      10      mail
mail    IN      A       51.83.29.198

www     IN      A       51.83.29.198
